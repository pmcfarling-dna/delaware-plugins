{
  "mcpServers": {
    "fiori-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@sap-ux/fiori-mcp-server@1.15.24",
        "fiori-mcp"
      ],
      "env": {
        "SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY": "true"
      }
    },
    "ui5-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@ui5/mcp-server@0.3.3"
      ]
    },
    "cds-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@cap-js/mcp-server@0.1.0"
      ]
    }
  }
}
